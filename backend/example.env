# Optional Hugging Face token (used only if you run HF model IDs).
# Leave empty unless you have a valid token; a bad token breaks public downloads.
HF_TOKEN=

# GGUF model source
# Set either SPONGE_GGUF_PATH (single model) OR SPONGE_GGUF_DIR (folder of variants).
SPONGE_GGUF_PATH=
SPONGE_GGUF_DIR=

# GPTQ local cache (optional). If set, GPTQModel will load from this folder first.
SPONGE_GPTQ_DIR=

# Allow GPTQModel to use repo-provided model code when needed.
SPONGE_GPTQ_TRUST_REMOTE_CODE=1

# Optional: constrain variant matching to one model family, e.g. "mistral-7b-instruct-v0.3"
SPONGE_GGUF_BASENAME=

# llama.cpp / GGUF runtime knobs
SPONGE_GGUF_CTX=
SPONGE_GGUF_THREADS=
SPONGE_GGUF_GPU_LAYERS=

# SUPABASE_URL: project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=
# SUPABASE_API_KEY: service role or anon key for REST inserts
SUPABASE_API_KEY=
# SUPABASE_TABLE: table name for attack logs
SUPABASE_TABLE=

# Optional backend behavior flags
# SPONGE_ALLOW_CPU_INT8_FALLBACK=0
# SPONGE_ENABLE_BNB_ROCM=0
SPONGE_MAX_CONTEXT=

SPONGE_CONTEXT_DISABLE_OOM_RETRY=
SPONGE_CONTEXT_TARGET_TOKENS=
SPONGE_DEBUG_TRACEBACK=