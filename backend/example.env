# HF_TOKEN: optional Hugging Face token for gated models (leave empty if unused).
# An invalid/expired token causes 401 errors on public models — remove or fix it.
HF_TOKEN=

# SPONGE_GPTQ_MODEL_ID: fallback GPTQ repo
SPONGE_GPTQ_MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct-GPTQ-Int4
# Per-family GPTQ repos (used when UI backend = GPTQ)
SPONGE_GPTQ_MODEL_MISTRAL7B=TheBloke/Mistral-7B-Instruct-v0.2-GPTQ
SPONGE_GPTQ_MODEL_GPT2=
SPONGE_GPTQ_MODEL_OPT_6_7B=TheBloke/opt-6.7b-GPTQ

# SPONGE_HF_DIR: folder containing local HF FP16 model files
SPONGE_HF_DIR=/path/to/hf_models

# Per-family HF repos (used when UI backend = HF FP16)
SPONGE_HF_MODEL_LLAMA3=meta-llama/Llama-3.2-3B
SPONGE_HF_MODEL_QWEN=Qwen/Qwen2.5-3B-Instruct
SPONGE_HF_MODEL_HUNYUAN=tencent/Hunyuan-4B-Instruct

# SPONGE_HF_TRUST_REMOTE_CODE: set to 1 only if required by the model
SPONGE_HF_TRUST_REMOTE_CODE=0

# SPONGE_GGUF_PATH: full path to a single GGUF file (optional)
SPONGE_GGUF_PATH=

# SPONGE_GGUF_DIR: folder containing GGUF files
SPONGE_GGUF_DIR=/path/to/models

# SPONGE_GGUF_BASENAME: optional substring to filter GGUF selection
SPONGE_GGUF_BASENAME=

# SPONGE_GGUF_CTX: llama.cpp context size
SPONGE_GGUF_CTX=4096

## SPONGE_GGUF_THREADS: (removed, CPU stats not tracked)
SPONGE_GGUF_THREADS=8

# SPONGE_GGUF_GPU_LAYERS: number of layers offloaded to GPU (-1 = auto)
SPONGE_GGUF_GPU_LAYERS=-1

# SUPABASE_URL: project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# SUPABASE_API_KEY: service role or anon key for REST inserts
SUPABASE_API_KEY=

# SUPABASE_TABLE: table name for attack logs
SUPABASE_TABLE=sponge_attack_runs