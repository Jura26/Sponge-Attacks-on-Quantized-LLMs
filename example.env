# Example environment configuration
# Copy sections into scripts/.env and backend/.env as needed.
# All paths and tokens below are placeholders.

############################
# scripts/.env
############################
# DEST_DIR: output folder for downloaded/converted GGUF files
DEST_DIR=/path/to/models

# MODELS: comma-separated model keys to download
MODELS=gpt2-small,opt-6.7b,mistral7b

# DRY_RUN: 1 prints actions without downloading/building
DRY_RUN=0

# OPT_LOCAL_BUILD / GPT2_LOCAL_BUILD / MISTRAL_LOCAL_BUILD:
#   auto | always | never (local HF->GGUF build mode)
OPT_LOCAL_BUILD=auto
GPT2_LOCAL_BUILD=auto
MISTRAL_LOCAL_BUILD=auto

# VARIANT_SET: best (subset) or all (every GGUF file in repo)
VARIANT_SET=best

# OPT_HF_MODEL_ID / GPT2_HF_MODEL_ID / MISTRAL_HF_MODEL_ID:
#   HF repo IDs used for local base (f16) conversion
OPT_HF_MODEL_ID=facebook/opt-6.7b
GPT2_HF_MODEL_ID=openai-community/gpt2
MISTRAL_HF_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2

# OPT_WORK_DIR / GPT2_WORK_DIR / MISTRAL_WORK_DIR:
#   Optional local folders for HF snapshot downloads (blank = auto)
OPT_WORK_DIR=
GPT2_WORK_DIR=
MISTRAL_WORK_DIR=

# LLAMA_CPP_DIR: path to llama.cpp for converter/quantizer tools
LLAMA_CPP_DIR=/path/to/llama.cpp

# HF_TOKEN: optional Hugging Face token for gated models
HF_TOKEN=

# SPONGE_HF_DIR: destination for HF FP16 model downloads
SPONGE_HF_DIR=/path/to/hf_models

# OPT67_GGUF_REPO / GPT2_GGUF_REPO:
#   Optional overrides for GGUF repos used for downloads
# OPT67_GGUF_REPO=
# GPT2_GGUF_REPO=